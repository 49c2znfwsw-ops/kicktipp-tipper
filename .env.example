# Kicktipp-Zugang (dein normaler Login)
KICKTIPP_USER=du@example.com
KICKTIPP_PASSWORD=geheim

# Optional: Schlüssel für https://the-odds-api.com (Free Tier reicht, 500 Abfragen/Monat).
# Einfacher: direkt im Reiter "Quoten" eintragen. Abruf nur auf Klick, fließt nicht in die Prognose ein.
ODDS_API_KEY=

# Optional, aber dringend empfohlen, wenn die Oberfläche aus dem Internet erreichbar ist:
# Passwort für die Web-Oberfläche (HTTP Basic Auth, Benutzername beliebig)
UI_PASSWORD=
